class Solution {
    public boolean isBinaryPalindrome(int n) {
        String s="";
        
        while(n>0){
            if(n%2==0)
                s="0"+s;
            else
                s="1"+s;
            n=n/2;
        }
        
        for(int i=0;i<s.length()/2;i++){
            if(s.charAt(i)!=s.charAt(s.length()-1-i))
                return false;
        }
        
        return true;
    }
};
